# ─────────────────────────────────────────────────────────────
#  Maison Web — environment variables
#  Copy to apps/web/.env.local
# ─────────────────────────────────────────────────────────────

# Where the Express API runs. Used server-side and for the /api/v1 proxy.
API_ORIGIN=http://localhost:4000

# Public URL of this storefront (canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key — only needed when the API has STRIPE_SECRET_KEY set.
# Leave empty to use demo (mock) payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Must match REVALIDATE_SECRET in apps/api/.env (enables instant refresh after admin edits)
REVALIDATE_SECRET=
