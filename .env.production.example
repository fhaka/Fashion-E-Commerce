# ─────────────────────────────────────────────────────────────
#  Maison — production settings for docker-compose.prod.yml
#  cp .env.production.example .env.production   (never commit .env.production)
#
#  Generate each secret with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────

# Public domain of the shop (DNS must point at this server). Use "localhost" to try the stack locally.
DOMAIN=shop.example.com

# Host ports Caddy listens on
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL (internal only — never published)
POSTGRES_USER=maison
POSTGRES_PASSWORD=
POSTGRES_DB=maison

# Auth — two different random strings, at least 32 characters each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Instant storefront refresh after admin edits (random string; shared by API and web)
REVALIDATE_SECRET=

# Payments — leave both Stripe keys empty to run in DEMO (mock) mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Image storage — strongly recommended in production (otherwise uploads go to a Docker volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maison

# Email (password resets, order confirmations, shipping updates). REQUIRED for a real shop:
# without SMTP_HOST emails are only written to the API log. Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Maison <no-reply@shop.example.com>"

ORDER_RESERVATION_MINUTES=30
LOG_LEVEL=info

# Only used by the optional demo seed (docker compose ... run --rm migrate npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# The seed deletes ALL data first. It refuses on a database that has orders unless this is true.
SEED_ALLOW_RESET=false
