# ─────────────────────────────────────────────────────────────
#  Maison API — environment variables
#  Copy to apps/api/.env and adjust. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Public URL of the storefront (used for CORS, emails, Stripe redirects)
WEB_URL=http://localhost:3000
# Public URL of this API (used to build absolute URLs for local uploads)
API_URL=http://localhost:4000

# PostgreSQL — docker-compose exposes the database on host port 5434
DATABASE_URL=postgresql://maison:maison@localhost:5434/maison?schema=public

# JWT — generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Cookies — set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Shared with the storefront (apps/web REVALIDATE_SECRET) so admin edits appear instantly.
# Leave empty to rely on the storefront's normal 1–5 minute cache refresh.
REVALIDATE_SECRET=

# Comma-separated list of allowed CORS origins (in addition to WEB_URL)
CORS_ORIGINS=

# Payments — leave STRIPE_SECRET_KEY empty to use the built-in MOCK provider (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Image storage — leave empty to store uploads on local disk (apps/api/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maison

# Minutes a PENDING order keeps its stock reserved
ORDER_RESERVATION_MINUTES=30

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Seed: credentials for the admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@maison.test
SEED_ADMIN_PASSWORD=Admin12345!
